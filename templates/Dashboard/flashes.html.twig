{% set flashStyles = {
    'success': {
        'bg': 'bg-green-50',
        'text': 'text-green-900',
        'icon': 'fa-solid fa-circle-check'
    },
    'warning': {
        'bg': 'bg-yellow-50',
        'text': 'text-yellow-900',
        'icon': 'fa-solid fa-triangle-exclamation'
    },
    'error': {
        'bg': 'bg-rose-50',
        'text': 'text-rose-900',
        'icon': 'fa-solid fa-circle-xmark'
    },
    'default': {
        'bg': 'bg-blue-50',
        'text': 'text-blue-900',
        'icon': 'fa-solid fa-circle-info'
    }
} %}
{# Build a local copy of the flashes so a test message can be injected for manual QA. #}
{% set flashes = {} %}
{% for label, messages in app.flashes %}
    {% set flashes = flashes|merge({ (label): messages }) %}
{% endfor %}

{# TEST MESSAGE - always visible, for manual QA of Flowbite styling/dismiss behavior. Remove before merging. #}
{% set flashes = flashes|merge({ 'success': (flashes.success|default([]))|merge(['TEST success banner: this always displays for QA purposes. Remove once styling is confirmed.']) }) %}
{% set flashes = flashes|merge({ 'warning': (flashes.warning|default([]))|merge(['TEST warning banner: this always displays for QA purposes. Remove once styling is confirmed.']) }) %}
{% set flashes = flashes|merge({ 'error': (flashes.error|default([]))|merge(['TEST error banner: this always displays for QA purposes. Remove once styling is confirmed.']) }) %}
{% set flashes = flashes|merge({ 'default': (flashes.default|default([]))|merge(['TEST default banner: this always displays for QA purposes. Remove once styling is confirmed.']) }) %}

{% set flashIndex = 0 %}
{% for label, messages in flashes %}
    {% set style = flashStyles[label]|default(flashStyles['default']) %}
    {% for message in messages %}
        {% set flashIndex = flashIndex + 1 %}
        <div id="flash-banner-{{ flashIndex }}" class="flex items-center p-4 mb-4 text-sm rounded-lg {{ style.bg }} {{ style.text }}" role="alert">
            <i class="{{ style.icon }} shrink-0 w-4 h-4 me-3" aria-hidden="true"></i>
            <span class="sr-only">{{ label|capitalize }}</span>
            <div class="font-medium">
                {{ message }}
            </div>
            <button
                type="button"
                class="ms-auto -mx-1.5 -my-1.5 rounded-lg focus:ring-2 p-1.5 inline-flex items-center justify-center h-8 w-8 hover:bg-black/5"
                data-dismiss-target="#flash-banner-{{ flashIndex }}"
                aria-label="Close"
            >
                <span class="sr-only">Close banner</span>
                <i class="fa-solid fa-xmark w-3 h-3" aria-hidden="true"></i>
            </button>
        </div>
    {% endfor %}
{% endfor %}
