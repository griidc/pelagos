{% extends "base.html.twig" %}

{% block title %}Dataset Information Form{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    {{ encore_entry_link_tags('dif') }}

    <link href="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>

    <style>
        .ts-control {
            border-style: var(--tw-border-style);
            display: block;
            width: 100%;
            border-radius: 0.5rem;
            border-width: 1px;
            --tw-border-opacity: 1;
            border-color: rgb(209 213 219 / var(--tw-border-opacity, 1));
            --tw-bg-opacity: 1;
            background-color: rgb(249 250 251 / var(--tw-bg-opacity, 1));
            padding: 0.625rem;
            font-size: 0.875rem;
            line-height: 1.25rem;
            --tw-text-opacity: 1;
            color: rgb(17 24 39 / var(--tw-text-opacity, 1));
        }

        /* Needed for Project Title */
        #researchGroup-ts-control > input {
            font-size: 0.875rem !important;
            line-height: 1.25rem !important;
        }

        /* Needed for Funder */
        .ts-control input#funders-ts-control {
            font-size: 0.875rem !important;
            line-height: 1.25rem !important;
        }
        .ts-control:has(#funders-ts-control) {
            display: flex !important;
            flex-wrap: wrap !important;
        }

        .ts-control:focus {
            --tw-border-opacity: 1;
            border-color: rgb(59 130 246 / var(--tw-border-opacity, 1));
            --tw-ring-opacity: 1;
            --tw-ring-color: rgb(59 130 246 / var(--tw-ring-opacity, 1));
        }

        .ts-dropdown .ts-dropdown-content {
            max-height: 440px;
            box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.50);
        }

        .choice-label {
            font-weight: normal;
            display: inline;
        }

        label.required::before
        {
            font-weight: bold; color:#b81111;
            content:"*";
        }

        .leaflet-control-layers-selector {
            appearance: revert;
        }
    </style>

{% endblock stylesheets %}

{% block javascripts %}
    {{ parent() }}

    {{ encore_entry_script_tags('dif') }}

    <script src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>

    <script>
        function showSection(sectionId) {
            document.dispatchEvent(new CustomEvent('sectionChange', { detail: { section: sectionId } }));
            document.querySelectorAll('[data-form-section]').forEach((section) => {
                section.classList.toggle('hidden', section.id !== sectionId);
            });
            requestAnimationFrame(() => {
                document.scrollIntoView({ behavior: 'instant', block: 'start' });
            });
            document.querySelectorAll('[data-section-button]').forEach((button) => {
                const isActive = button.dataset.sectionButton === sectionId;
                button.setAttribute('aria-selected', isActive);
                button.classList.toggle('bg-gray-100', !isActive);
                button.classList.toggle('border-gray-100', !isActive);
                button.classList.toggle('bg-blue-50', isActive);
                button.classList.toggle('border-blue-600', isActive);
            });
        }
    </script>
{% endblock javascripts %}

{% block body %}
    <div class="max-w-screen-xl mx-auto py-6">
        {% for message in app.flashes('error') %}
            <div class="p-4 mb-4 text-sm text-rose-900 rounded-xl bg-rose-50" role="alert">
                <span class="font-medium">{{ message }}</span>
            </div>
        {% endfor %}

        <h2>Dataset Information Form</h2>

        {% if udi is not empty %}
            <div  class="border p-4 text-xl mb-4 rounded-lg">Unique Dataset Identifier (UDI): {{ udi }}</div>
        {% endif %}

        <div class="flex flex-1 gap-6 not-prose">
            <div class="w-1/6 sticky top-6 h-fit w-64 shrink">
                <ol class="space-y-4 w-64">
                    <li style="cursor: pointer;">
                        <button
                            type="button" data-section-button="contact" aria-selected="true" onclick="showSection('contact')"
                            class="lg:w-full w-3/4 p-4 text-left text-gray-900 bg-blue-50 border border-blue-600 rounded-lg">
                            <div class="flex items-center justify-between">
                                <h3 class="font-medium">Dataset Contact</h3>
                            </div>
                        </button>
                    </li>
                    <li style="cursor: pointer;">
                        <button
                            type="button" data-section-button="information" aria-selected="false" onclick="showSection('information')"
                            class="lg:w-full w-3/4 p-4 text-left text-gray-900 bg-gray-100 border border-gray-300 rounded-lg">
                            <div class="flex items-center justify-between">
                                <h3 class="font-medium">Dataset Information</h3>
                            </div>
                        </button>
                    </li>
                    <li style="cursor: pointer;">
                        <button
                            type="button" data-section-button="extent" aria-selected="false" onclick="showSection('extent')"
                            class="lg:w-full w-3/4 p-4 text-left text-gray-900 bg-gray-100 border border-gray-300 rounded-lg">
                            <div class="flex items-center justify-between">
                                <h3 class="font-medium">Data Extent</h3>
                            </div>
                        </button>
                    </li>
                    <li style="cursor: pointer;">
                        <button
                            type="button" data-section-button="submit" aria-selected="false" onclick="showSection('submit')"
                            class="lg:w-full w-3/4 p-4 text-left text-gray-900 bg-gray-100 border border-gray-300 rounded-lg">
                            <div class="flex items-center justify-between">
                                <h3 class="font-medium">Submit</h3>
                            </div>
                        </button>
                    </li>
                </ol>
            </div>

            <div id="formcontent" class="w-5/6">
               {% include 'DIF/difForm.v2.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}
