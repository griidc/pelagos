{% extends "base.html.twig" %}

{% block title %}Dataset Information Form{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    {{ encore_entry_link_tags('dif') }}
{% endblock stylesheets %}

{% block javascripts %}
    {{ parent() }}
{% endblock javascripts %}

{% block body %}
  <div class="max-w-screen-xl mx-auto py-6">
        {% for message in app.flashes('error') %}
            <div class="p-4 mb-4 text-sm text-rose-900 rounded-xl bg-rose-50" role="alert">
                <span class="font-medium">{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('success') %}
            {# <div class="p-4 mb-4 text-sm text-green-700 rounded-xl bg-green-100" role="alert">
                <span class="font-medium">Success! {{ message }}</span>
            </div> #}
        {% endfor %}
        <div>
            {% set complete = datasetSubmission.status == constant('App\\Entity\\DatasetSubmission::STATUS_COMPLETE') %}
            <section class="bg-white py-8 antialiased md:py-16">
            <div class="mx-auto max-w-2xl px-4 2xl:px-0">
                <h2 class="text-xl font-semibold text-gray-900 sm:text-2xl mb-4">
                {% if complete %}
                    Congratulations!
                {% else %}
                    Draft Saved
                {% endif %}
                </h2>
                <p class="text-gray-500 mb-6 md:mb-8">
                {% if complete %}
                    You have successfully submitted a dataset. The GRIIDC identifier for this dataset is
                {% else %}
                    You have saved a dataset submission. Please return to the form to submit the dataset. The GRIIDC identifier is
                {% endif %}
                    <a href="{{ url('pelagos_app_ui_dataland_default', {'udi': datasetSubmission.dataset.udi}) }}" class="pagelink">{{ datasetSubmission.dataset.udi }}</a>. A confirmation email has been sent to your inbox.
                </p>
                <p class="text-gray-500 mb-6 md:mb-8">
                    <span class="font-semibold">Next steps:</span>
                {% if complete %}
                    GRIIDC will review the dataset and contact you with any questions or requests for additional information. Please respond to emails in a timely manner. Once the review is finalized, you will receive an email.
                {% else %}
                    <a href="{{ url('pelagos_app_ui_datasetsubmission_default') }}?udi={{datasetSubmission.dataset.udi}}" class="pagelink">Submit dataset</a>.
                {% endif %}
                </p>
                <div class="space-y-4 sm:space-y-2 rounded-lg border border-gray-200 bg-gray-50 p-6 mb-6 md:mb-8 shadow-lg">
                    <dl class="sm:flex items-center justify-left gap-2">
                        <dt class="font-semibold mb-1 sm:mb-0 text-gray-500">Research Group:</dt>
                        <dd class="font-normal text-gray-500">{{ datasetSubmission.dataset.researchGroup.name }}</dd>
                    </dl>
                    <dl class="sm:flex items-center justify-left gap-2">
                        <dt class="font-semibold mb-1 sm:mb-0 text-gray-500">Title:</dt>
                        <dd class="font-normal text-gray-500">{{ datasetSubmission.title }}</dd>
                    </dl>
                    {% if complete %}
                    <dl class="sm:flex items-center justify-left gap-2">
                        <dt class="font-semibold mb-1 sm:mb-0 text-gray-500">DOI:</dt>
                        <dd class="font-normal text-gray-500"><a class="pagelink" href="https://doi.org/{{ datasetSubmission.dataset.doi.doi }}">"https://doi.org/{{ datasetSubmission.dataset.doi.doi }}</a></dd>
                    </dl>
                    <dl class="sm:flex items-center justify-left gap-2">
                        <dt class="font-semibold mb-1 sm:mb-0 text-gray-500">Restrictions:</dt>
                        <dd class="font-normal text-gray-500">{{ datasetSubmission.restrictions }}</dd>
                    </dl>
                    {% endif %}
                </div>
                <div class="flex items-center space-x-4">
                    <a href="{{ url('app_ui_dashboard') }}" class="button button-regular button-form">View Datasets</a>
                    <a href="{{ mainsite }}/contact" class="button button-regular button-form">Contact Us</a>
                </div>
            </div>
            </section>
        </div>
    </div>
{% endblock body %}
